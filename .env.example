# Public configuration only. Copy to .env and fill in values for your environment.
# NEVER put secrets in EXPO_PUBLIC_* variables: they are embedded in the app bundle.

# Local backend. Use http://127.0.0.1:4000 for web/iOS Simulator,
# http://10.0.2.2:4000 for an Android emulator, or http://<LAN-IP>:4000 for a phone.
EXPO_PUBLIC_API_BASE_URL=

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Phase 11 offline cache maximum age in hours (default 24). Public, not a secret.
EXPO_PUBLIC_OFFLINE_CACHE_MAX_AGE_HOURS=

# Set to false only for no-Storage environments such as a real Firebase Spark plan.
# Defaults to true. When false, image uploads are disabled and screens keep working.
EXPO_PUBLIC_STORAGE_ENABLED=

# Development only: set to true to use the local Auth/Firestore/Storage emulators.
EXPO_PUBLIC_USE_EMULATOR=

# Optional host override for all three client emulators. Leave empty for automatic
# selection: 127.0.0.1 on web/iOS, 10.0.2.2 on Android. For a physical device,
# use this computer's LAN IP and bind the emulators to 0.0.0.0 in firebase.json.
# Do not include a protocol or port.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
