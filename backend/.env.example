# Backend configuration. Copy to .env and fill in values for your environment.
# Never commit .env or service-account files.

PORT=
NODE_ENV=
# Comma-separated origins for Expo web, for example:
# http://localhost:8081,http://127.0.0.1:8081
CORS_ORIGINS=

# Phase 02 (Firebase Admin SDK). Use a service account with least privilege.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional: defaults to <FIREBASE_PROJECT_ID>.appspot.com
FIREBASE_STORAGE_BUCKET=

# Local emulators only. Leave empty for a real Firebase project.
# When set, service-account values above are not required.
# Use 127.0.0.1 for this PC (web, Android emulator, or iOS Simulator backend).
# For a physical device, use this computer's LAN IP and bind emulators to 0.0.0.0.
# Do not include a protocol.
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# Weather proxy (optional overrides; defaults to Open-Meteo).
OPEN_METEO_FORECAST_URL=
OPEN_METEO_GEOCODING_URL=
WEATHER_CACHE_TTL_MS=
WEATHER_REQUEST_TIMEOUT_MS=

# Phase 09 (AI). Keys and model stay on the backend; never put them in the app.
# Required for the assistant: API key and the project-approved model code.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional assistant limits (defaults: 15s timeout, 1 retry, 50 messages/day,
# 20 diagnoses/day, 8 history messages, 6000 prompt chars, 600 output tokens).
GEMINI_REQUEST_TIMEOUT_MS=
GEMINI_RETRIES=
AI_DAILY_MESSAGE_LIMIT=
AI_DAILY_DIAGNOSIS_LIMIT=
AI_HISTORY_LIMIT=
AI_PROMPT_MAX_CHARS=
AI_MAX_OUTPUT_TOKENS=
# Required for disease detection; no model is chosen by this repository.
DISEASE_MODEL_ENDPOINT=
DISEASE_MODEL_API_KEY=
# Placeholder confidence bands: uncertain < 0.5, possible 0.5..0.8, likely > 0.8.
DISEASE_UNCERTAIN_MAX=
DISEASE_POSSIBLE_MAX=

# Phase 07 (payments)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=
