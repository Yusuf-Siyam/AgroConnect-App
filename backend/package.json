{
  "name": "agroconnect-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AgroConnect REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/app.test.ts src/config/deliveryPricing.test.ts src/config/firebase.test.ts src/middleware/auth.test.ts src/services/userProfile.test.ts",
    "admin:provision": "tsx src/scripts/provision-admin.ts",
    "market:import": "tsx src/scripts/import-market-prices.ts",
    "seed:dev-paid-order": "tsx src/scripts/seedDevPaidOrder.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
