# AgroConnect ignore rules
# Mobile: Expo / React Native / NativeWind. Backend: Node.js / Express / TypeScript.

# Dependencies (root and backend)
node_modules/

# Expo, Metro and React Native generated files
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
/ios/
/android/
*.apk
*.aab
*.ipa
*.app
*.hbc
*.bundle

# Backend and test build outputs
backend/dist/
coverage/
.nyc_output/
*.lcov
junit.xml

# Local Firebase emulator export (contains user data; never commit)
emulator-data/

# Environment variables, credentials and service accounts
.env
.env.*
!.env.example
*.pem
*.p8
*.p12
*.key
*.pfx
*.jks
*.keystore
*.mobileprovision
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist
.firebase/
firebase-debug.log

# Logs, caches and temporary files
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
bun-debug.log*
*.tmp
*.swp
*.swo
*~
.cache/
.parcel-cache/
.turbo/

# Editor and operating-system files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# TypeScript incremental build info
*.tsbuildinfo
